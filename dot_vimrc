function! s:list_async_tasks()
	let rows = asynctasks#source(&columns * 48 / 100)
	let source = []
	for row in rows
		let source += [printf('%s  %s  : %s', row[0], row[1], row[2])]
	endfor
	return source
endfunction

function! s:fzf_sink(line)
	" Extract the task name, which is the first part of the string
