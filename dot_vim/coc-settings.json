{
  "clangd.path": "/usr/bin/clangd",
  "clangd.checkUpdates": false,
  "clangd.disableFileStatus": true,
  // THE single biggest live-editing win found (measured, pty harness, kernel/fork.c):
  // cursor-move latency-to-last-byte 50.2ms -> 5.7ms.
  //
  // While clangd is building its background index -- effectively always in a kernel
  // tree; .cache/clangd/index here holds ~14500 shards -- it reports LSP $/progress.
  // coc renders that in the status line, and StatusLine's `setInterval(..., 100)`
  // splices a fresh spinner frame into the text on every tick, so the text always
  // differs, so it fires CocStatusChange through coc#util#timer -> s:Call
  // (autoload/coc/util.vim:291-301), whose body ends in `redraw`. That is a full-screen
  // redraw 10 times a second, forever, independent of typing -- 219 calls / 0.138s self
  // in the profile, the largest coc entry by self time.
  //
  // NOTE the "notification.disabledProgressSources" line below is INERT and does not
  // do this job, for two independent reasons: the list is only consulted on the *float*
  // branch of withProgress (which notification.statusLineProgress=true never takes),
  // and the source string is "language-client-clangd", not "clangd".
  //
  // Trade-off: no "indexing N%" text in the statusline. Indexing itself is unaffected
  // (it is a clangd background thread); this only turns off the LSP progress feature,
  // which also means no progress text for e.g. clangd.memoryUsage. Diagnostics,
  // completion and semantic tokens are untouched -- disabledFeatures is per-feature.
  "clangd.disableProgressNotifications": true,
  "semanticTokens.filetypes": ["*"],
  "inlayHint.enable": false,
  "notification.disabledProgressSources": ["clangd", "rust-analyzer"],
  "suggest.maxCompleteItemCount": 10,
  // :CocInstall / :CocUpdate need this. There is no direct egress on this box --
  // raw node DNS gets ENOTFOUND -- and coc's fetcher reads http.proxy rather than
  // npm's config, which is why `npm view` works from a shell but :CocInstall fails
  // with "getaddrinfo ENOTFOUND registry.npmjs.org". The nvim config solves the
  // same problem by exporting HTTP_PROXY in lua/config/lazy.lua; this is narrower,
  // since it applies to coc only and not to everything Vim spawns.
  // Devserver-specific: drop it if this config is ever used off a Meta host.
  // Yank ring (<leader>yk -> :CocList yank). coc-yank defaults to ALSO feeding
  // yank history into the completion menu (yank.enableCompletion, up to
  // yank.limit=3 items at priority 90). With maxCompleteItemCount capped at 10
  // that would spend 3 of the 10 slots on previously-yanked text, pushing clangd
  // results out. The ring is what's wanted here, not the completion source.
  "yank.enableCompletion": false,
  // Briefly flash the yanked region (the nvim config gets this from
  // vim.highlight.on_yank; vim had no equivalent).
  "yank.highlight.enable": true,
  "yank.highlight.duration": 300,
  "yank.list.maxsize": 200,
  // Statusline breadcrumb (b:coc_current_function, rendered by airline's
  // 'coc_current_function' part in its default g:airline_section_x). Deliberately
  // OFF: context.vim's sticky header already shows the enclosing function, and more
  // usefully -- it shows the whole nesting chain (function / if / for) rather than
  // just the function name, and in place at the top of the window rather than in the
  // corner. Keeping both would pay twice for the same information: this one issues a
  // documentSymbols request on a 300ms debounce after every cursor move.
  // false is also coc's default, so this line is documentation rather than override.
  "coc.preferences.currentFunctionSymbolAutoUpdate": false,
  // Outline sidebar (<leader>ot). Matches the nvim outline.nvim geometry:
  // left-hand split, 20 columns (coc's default is "botright 30vs"), and symbols
  // in document order rather than grouped by kind (coc's default is "category").
  "outline.splitCommand": "topleft 20vs",
  "outline.sortBy": "position",
  // autoWidth defaults to true and grows the pane past splitCommand's width
  // (measured: 32 columns instead of 20). false keeps it fixed, like nvim's.
  "outline.autoWidth": false,
  "rust-analyzer.server.path": "/home/zmen/.cargo/bin/rust-analyzer",
  "workspace.ignoredFolders": [
    "$HOME",
    "$HOME/.cargo/**",
    "$HOME/.rustup/**"
  ]
}
