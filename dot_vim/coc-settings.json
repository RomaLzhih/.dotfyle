{
  "clangd.checkUpdates": false,
  "clangd.disableFileStatus": true,
  "clangd.disableProgressNotifications": true,
  "semanticTokens.filetypes": ["*"],
  "inlayHint.enable": false,
  "notification.disabledProgressSources": ["clangd"],
  "suggest.maxCompleteItemCount": 10,
  "yank.enableCompletion": false,
  "yank.highlight.enable": true,
  "yank.highlight.duration": 300,
  "yank.list.maxsize": 200,
  "coc.preferences.currentFunctionSymbolAutoUpdate": false,
  "outline.splitCommand": "topleft 20vs",
  "outline.sortBy": "position",
  "outline.autoWidth": false,
}
