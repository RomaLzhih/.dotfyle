" Skip quickfix buffer when switching
function! SwitchBuffer(direction)
  let start_buf = bufnr('%')
  let buf = start_buf
  
  while 1
    if a:direction == 'next'
      bnext
    else
      bprevious
    endif
    
    let buf = bufnr('%')
    
    " Stop if we're not in quickfix or location list
    if &buftype != 'quickfix'
      break
    endif
    
    " Prevent infinite loop if all buffers are quickfix
    if buf == start_buf
      break
    endif
  endwhile
endfunction

